# Secrets — never commit your Roboflow API key
.env
*.env

# Model weights: stray/downloaded weights stay out, models/ is tracked via Git LFS
*.pt
*.onnx
!models/*.pt
!models/*.onnx

# OpenVINO exports (regenerate from the .pt weights with export_openvino)
*_openvino_model/

# Roboflow dataset exports + local training runs (large, reproducible from Roboflow)
datasets/
runs/

# Training console output
runs_train*.log
runs_train*.err

# Roboflow workflow image outputs written to disk
rf_*.jpg
calibration.jpg

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
.venv-stream/
venv/

# The built UI bundle IS committed on purpose: it is how the Raspberry Pi gets
# the frontend without a Node toolchain. Regenerate it only with
# scripts/build_ui.ps1 - never hand-edit app/static/ui.
